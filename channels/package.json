{
  "name": "channels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CopilotKit Channels Slack surface. Forwards mentions to the Python LangGraph agent over AG-UI (see ../agent).",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file=../.env --import tsx --watch src/server.ts",
    "start": "node --env-file=../.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "channel:login": "npx --yes copilotkit@latest login",
    "channel:add": "cd .. && npx --yes copilotkit@latest channels add --name mytro --display-name \"Mytro\" --adapter slack --json",
    "channel:status": "cd .. && npx --yes copilotkit@latest channels status --json",
    "doctor": "node --env-file-if-exists=../.env --import tsx src/doctor.ts",
    "cards:preview": "node --import tsx src/components/preview.ts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@copilotkit/channels": "0.9.2",
    "@copilotkit/channels-ui": "0.9.2",
    "@copilotkit/runtime": "1.71.1",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@copilotkit/channels-slack": "0.9.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
