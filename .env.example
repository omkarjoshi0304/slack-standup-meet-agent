# Copy to .env in the repo root. Never commit the real .env (it's git-ignored).

# --- CopilotKit Channels (channels/, Node — F1/A1) ---
# From `copilotkit channels add --adapter slack ...` (see channels/README.md).
# Must equal the Channel Code shown in the Intelligence dashboard, character-for-character
# — a mismatch fails late as dashboard state "Waiting for runtime".
CHANNEL_CODE=mytro
# From your CopilotKit Intelligence project. Format: cpk-{projectId}_...
# NOTE: `copilotkit project select` provisions this as CPK_INTELLIGENCE_API_KEY, not this
# name. Copy the value across and keep both entries — server.ts reads INTELLIGENCE_API_KEY.
INTELLIGENCE_API_KEY=
# Leave unset unless self-hosting Intelligence.
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
# Port the Channels Node server listens on.
PORT=3000
# Without this, the listener's "channel requires setup" diagnostic logs at warn while the
# default log level is error — the message is written and discarded.
LOG_LEVEL=debug

# --- Python LangGraph agent (agent/, F2) ---
# Where CopilotKit Channels reaches the Python agent (must include the /agent path).
AGENT_URL=http://localhost:8000/agent
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
# Model provider used inside the LangGraph agent.
OPENAI_API_KEY=

# --- Persistence (core/, F4) ---
DATABASE_URL=sqlite:///./standup_meet.db

# --- Slack (scheduled/proactive posts — C6) ---
SLACK_BOT_TOKEN=

# --- Auth0 Token Vault (per-user delegated auth — C1) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Connection names configured in your Auth0 tenant for each provider.
AUTH0_GOOGLE_CONNECTION=google-oauth2
AUTH0_JIRA_CONNECTION=
# Optional: comma-separated upstream scopes requested at linking time
# (e.g. AUTH0_GOOGLE_CONNECTION_SCOPE=https://www.googleapis.com/auth/calendar).
AUTH0_GOOGLE_CONNECTION_SCOPE=
AUTH0_JIRA_CONNECTION_SCOPE=

# --- Account linking (C2) ---
# Must be registered in Auth0's Allowed Callback URLs. During local dev with a
# single user on the same machine, http://localhost:8000/link/callback works;
# for real teammates linking from their own browsers, this must be a public
# HTTPS URL (e.g. via ngrok) pointing at agent/main.py's /link/callback route.
AUTH0_REDIRECT_URI=http://localhost:8000/link/callback
# Signs the OAuth `state` param so the callback can recover which Slack user +
# provider started the flow, and reject tampering. Any long random string.
LINK_STATE_SECRET=

# --- Jira (C3) ---
JIRA_BASE_URL=

# --- Google Calendar (C4/C5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
